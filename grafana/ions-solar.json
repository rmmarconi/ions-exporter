      "uid": "${datasource}"
     },
     "expr": "max_over_time(solar_energy_today_kwh{site=~\"$site\",inverter=~\"$inverter\"}[1d:5m])",
     "refId": "A",
     "legendFormat": "{{inverter}}"
    }
   ],
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 96
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 1,
      "spanNulls": false,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      },
      "drawStyle": "bars"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "sum"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1d",
   "id": 43
  },
  {
   "type": "timeseries",
   "title": "Daily maximum, last 24 h (panels)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
