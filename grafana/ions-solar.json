  {
   "type": "timeseries",
   "title": "Produced per day — this year",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (inverter) (max_over_time(solar_energy_today_kwh{site=~\"$site\",inverter=~\"$inverter\"}[1d]))",
     "refId": "A",
     "legendFormat": "{{inverter}}"
    }
   ],
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 87
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 1,
      "spanNulls": false,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      },
      "drawStyle": "bars"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum",
      "mean",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1d",
   "timeFrom": "now/y",
   "maxDataPoints": 400,
   "id": 42,
   "description": "Total produced each day (stacked by inverter). Legend shows total, mean and best day. Needs Prometheus retention of at least one year."
  },
  {
   "type": "timeseries",
   "title": "Daily maximum, last 24 h (inverters)",
